@using Microsoft.AspNetCore.Identity
@inject SignInManager<ReLuNet.Core.Entities.ApplicationUser> SignInManager
@{
    ViewData["Title"] = "ReLuNet - Learn Together";
}

<section class="home-hero">
    <div class="container">
        <div class="hero-content">
            <div class="hero-badge">✦ AI-Powered Tech Blog</div>
            <h1>Where Developers<br /><span class="gradient-text">Share &amp; Learn</span></h1>
            <p>Discover technical articles on AI, Machine Learning, Web Development and more. Written by developers, for developers.</p>
            <div class="hero-actions">
                <a asp-controller="Article" asp-action="Index" class="btn-accent">Browse Articles</a>
                @if (!SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Auth" asp-action="Register" class="btn-ghost">Start Writing</a>
                }
                else
                {
                    <a asp-controller="Article" asp-action="Create" class="btn-ghost">Write Article</a>
                }
            </div>
        </div>
        <div class="hero-visual">
            <div class="code-card">
                <div class="code-card-header">
                    <span class="dot red"></span>
                    <span class="dot yellow"></span>
                    <span class="dot green"></span>
                    <span class="code-card-title">neural_net.py</span>
                </div>
                <div class="code-card-body">
                    <pre><span class="c-purple">import</span> <span class="c-blue">torch</span>
<span class="c-purple">import</span> <span class="c-blue">torch.nn</span> <span class="c-purple">as</span> nn

<span class="c-green">class</span> <span class="c-yellow">ReLuNet</span>(nn.Module):
  <span class="c-green">def</span> <span class="c-blue">__init__</span>(self):
    super().__init__()
    self.fc1 = nn.<span class="c-yellow">Linear</span>(784, 256)
    self.relu = nn.<span class="c-yellow">ReLU</span>()

  <span class="c-green">def</span> <span class="c-blue">forward</span>(self, x):
    <span class="c-purple">return</span> self.<span class="c-blue">relu</span>(self.fc1(x))</pre>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-number">&#8734;</div>
                <div class="stat-label">Articles to Read</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">AI</div>
                <div class="stat-label">Powered Search</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">100%</div>
                <div class="stat-label">Free Forever</div>
            </div>
        </div>
    </div>
</section>

<section class="home-topics">
    <div class="container">
        <div class="section-header">
            <h2>Explore Topics</h2>
            <p>Find articles on what you want to learn</p>
        </div>
        <div class="topics-grid">
            <a asp-controller="Article" asp-action="Index" asp-route-search="machine learning" class="topic-card">
                <div class="topic-icon">&#129504;</div>
                <div class="topic-name">Machine Learning</div>
            </a>
            <a asp-controller="Article" asp-action="Index" asp-route-search="deep learning" class="topic-card">
                <div class="topic-icon">&#128300;</div>
                <div class="topic-name">Deep Learning</div>
            </a>
            <a asp-controller="Article" asp-action="Index" asp-route-search="web development" class="topic-card">
                <div class="topic-icon">&#127760;</div>
                <div class="topic-name">Web Development</div>
            </a>
            <a asp-controller="Article" asp-action="Index" asp-route-search="python" class="topic-card">
                <div class="topic-icon">&#128013;</div>
                <div class="topic-name">Python</div>
            </a>
            <a asp-controller="Article" asp-action="Index" asp-route-search="neural network" class="topic-card">
                <div class="topic-icon">&#9889;</div>
                <div class="topic-name">Neural Networks</div>
            </a>
            <a asp-controller="Article" asp-action="Index" asp-route-search="dotnet" class="topic-card">
                <div class="topic-icon">&#128156;</div>
                <div class="topic-name">.NET</div>
            </a>
        </div>
    </div>
</section>

@if (!SignInManager.IsSignedIn(User))
{
    <section class="home-cta">
        <div class="container">
            <div class="cta-card">
                <h2>Ready to share your knowledge?</h2>
                <p>Join ReLuNet and start writing technical articles today.</p>
                <a asp-controller="Auth" asp-action="Register" class="btn-accent">Get Started Free</a>
            </div>
        </div>
    </section>
}
