@model List<ReLuNet.Core.Entities.Bookmark>
@{
    ViewData["Title"] = "My Bookmarks";
}

<div class="container" style="padding-top: 40px;">
    <div class="page-header">
        <h2>My Bookmarks</h2>
    </div>

    @if (!Model.Any())
    {
        <p style="color:var(--text-muted); text-align:center; padding: 60px 0;">No bookmarks yet.</p>
    }
    else
    {
        <div class="articles-grid">
            @foreach (var bookmark in Model)
            {
                <div class="article-card">
                    <div class="article-card-body">
                        <div class="article-card-title">@bookmark.Article.Title</div>
                        <p style="color:var(--text-muted); font-size:0.85rem; margin-bottom:12px;">
                            By @bookmark.Article.Author.DisplayName
                        </p>
                        @if (bookmark.Article.Summary != null)
                        {
                            <div class="article-card-summary">@bookmark.Article.Summary</div>
                        }
                        <div class="article-card-meta">
                            <span>@bookmark.Article.ReadTime min read</span>
                            <a asp-controller="Article" asp-action="Read"
                               asp-route-slug="@bookmark.Article.Slug" class="read-btn">Read →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>