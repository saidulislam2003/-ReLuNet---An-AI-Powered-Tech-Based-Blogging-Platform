@model List<ReLuNet.Core.Entities.Article>
@{
    ViewData["Title"] = "My Articles";
}

<div class="container" style="padding-top: 40px;">
    <div class="page-header d-flex justify-content-between align-items-center">
        <h2>My Articles</h2>
        <a asp-action="Create" class="btn-accent">+ New Article</a>
    </div>

    @if (!Model.Any())
    {
        <p style="color:var(--text-muted); text-align:center; padding: 60px 0;">
            You haven't written any articles yet.
        </p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var article in Model)
                {
                    <tr>
                        <td>@article.Title</td>
                        <td>
                            <span class="badge @(article.Status == ReLuNet.Core.Entities.ArticleStatus.Published ? "bg-success" : "bg-warning")">
                                @article.Status
                            </span>
                        </td>
                        <td>@article.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@article.Id"
                               style="color:var(--accent); margin-right:12px; font-size:0.875rem; font-weight:600;">Edit</a>
                            <form asp-action="Delete" asp-route-id="@article.Id"
                                  method="post" class="d-inline">
                                <button type="submit"
                                        style="background:none; border:none; color:var(--danger); font-size:0.875rem; font-weight:600; cursor:pointer;"
                                        onclick="return confirm('Delete this article?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
