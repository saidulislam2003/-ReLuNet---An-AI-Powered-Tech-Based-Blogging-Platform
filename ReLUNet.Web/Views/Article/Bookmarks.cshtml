@model List<ReLuNet.Core.Entities.Bookmark>
@{
    ViewData["Title"] = "My Bookmarks";
}

<div class="container mt-4">
    <h3>My Bookmarks</h3>

    @if (!Model.Any())
    {
        <p class="text-muted">No bookmarks yet.</p>
    }

    <div class="row">
        @foreach (var bookmark in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@bookmark.Article.Title</h5>
                        <p class="text-muted small">By @bookmark.Article.Author.DisplayName</p>
                        @if (bookmark.Article.Summary != null)
                        {
                            <p class="card-text">@bookmark.Article.Summary</p>
                        }
                        <a asp-action="Read" asp-route-slug="@bookmark.Article.Slug" class="btn btn-sm btn-primary">Read</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>