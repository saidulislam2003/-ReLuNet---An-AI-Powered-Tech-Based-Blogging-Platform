@model List<ReLuNet.Core.Entities.Article>
@{
    ViewData["Title"] = "Articles";
}

<div class="container">
    <div class="hero">
        <h1>Discover & Learn</h1>
        <p>Technical articles written by developers, for developers.</p>
        <form asp-action="Index" method="get">
            <div class="search-wrapper">
                <input type="text" name="search" placeholder="Search articles, tags..." value="@ViewData["Search"]" />
                <button type="submit">Search</button>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <p style="color:var(--text-muted); text-align:center; padding: 60px 0;">No articles found.</p>
    }
    else
    {
        <div class="articles-grid">
            @foreach (var article in Model)
            {
                <div class="article-card">
                    @if (article.CoverImage != null)
                    {
                        <img src="@article.CoverImage" class="article-card-cover" />
                    }
                    <div class="article-card-body">
                        <div class="article-card-tags">
                            @foreach (var at in article.ArticleTags.Take(3))
                            {
                                <span class="tag-badge">@at.Tag.Name</span>
                            }
                        </div>
                        <div class="article-card-title">@article.Title</div>
                        @if (article.Summary != null)
                        {
                            <div class="article-card-summary">@article.Summary</div>
                        }
                        <div class="article-card-meta">
                            <span>@article.Author.DisplayName · @article.ReadTime min read</span>
                            <a asp-action="Read" asp-route-slug="@article.Slug" class="read-btn">Read →</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>