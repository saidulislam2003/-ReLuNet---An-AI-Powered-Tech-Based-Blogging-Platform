@model ReLuNet.Core.Entities.Article
@using Microsoft.AspNetCore.Identity
@inject UserManager<ReLuNet.Core.Entities.ApplicationUser> UserManager
@inject SignInManager<ReLuNet.Core.Entities.ApplicationUser> SignInManager
@{
    ViewData["Title"] = Model.Title;
    var userId = UserManager.GetUserId(User) ?? "";
    var isLiked = Model.Likes.Any(l => l.UserId == userId);
    var isBookmarked = Model.Bookmarks.Any(b => b.UserId == userId);
}

<div class="container">
    <div class="article-header">
        <div class="article-card-tags mb-3">
            @foreach (var at in Model.ArticleTags)
            {
                <span class="tag-badge">@at.Tag.Name</span>
            }
        </div>
        <h1>@Model.Title</h1>
        <div class="article-meta">
            <span>By <strong>@Model.Author.DisplayName</strong></span>
            <span>·</span>
            <span>@Model.PublishedAt?.ToString("MMM dd, yyyy")</span>
            <span>·</span>
            <span>@Model.ReadTime min read</span>
            <span>·</span>
            <span>♥ @Model.Likes.Count</span>
        </div>
    </div>

    @if (Model.CoverImage != null)
    {
        <div class="article-cover">
            <img src="@Model.CoverImage" alt="@Model.Title" />
        </div>
    }

    <div class="article-body">
        @Html.Raw(Model.Content)
    </div>

    @* Actions *@
    <div class="article-actions">
        @if (SignInManager.IsSignedIn(User))
        {
            <form asp-action="Like" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="slug" value="@Model.Slug" />
                <button type="submit" class="action-btn @(isLiked ? "active-like" : "")">
                    ♥ @(isLiked ? "Unlike" : "Like") (@Model.Likes.Count)
                </button>
            </form>
            <form asp-action="Bookmark" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="slug" value="@Model.Slug" />
                <button type="submit" class="action-btn @(isBookmarked ? "active-bookmark" : "")">
                    🔖 @(isBookmarked ? "Saved" : "Bookmark")
                </button>
            </form>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" class="action-btn">♥ Like (@Model.Likes.Count)</a>
            <a asp-controller="Auth" asp-action="Login" class="action-btn">🔖 Bookmark</a>
        }
    </div>

    @* Comments *@
    <div class="comments-section">
        <h5>Comments (@Model.Comments.Count)</h5>

        @if (SignInManager.IsSignedIn(User))
        {
            <form asp-action="Comment" method="post" class="comment-box mb-4">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="slug" value="@Model.Slug" />
                <div class="mb-2">
                    <textarea name="content" rows="3" placeholder="Share your thoughts..."></textarea>
                </div>
                <button type="submit" class="btn-accent" style="font-size:0.85rem; padding: 8px 20px;">Post Comment</button>
            </form>
        }
        else
        {
            <p style="color:var(--text-muted)"><a asp-controller="Auth" asp-action="Login">Login</a> to comment.</p>
        }

        @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
        {
            <div class="comment-item">
                <p>@comment.Content</p>
                <div class="d-flex justify-content-between align-items-center">
                    <small>@comment.User.DisplayName · @comment.CreatedAt.ToString("MMM dd, yyyy")</small>
                    @if (comment.UserId == userId)
                    {
                        <form asp-action="DeleteComment" method="post">
                            <input type="hidden" name="commentId" value="@comment.Id" />
                            <input type="hidden" name="slug" value="@Model.Slug" />
                            <button type="submit" style="background:none; border:none; color:var(--danger); font-size:0.8rem; cursor:pointer;"
                                    onclick="return confirm('Delete?')">Delete</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>